# Solana RPC endpoint (mainnet)
# Get a free one from https://www.helius.dev/ or https://www.quicknode.com/
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# LaserStream endpoint (optional override)
LASERSTREAM_ENDPOINT=https://laserstream-mainnet-ewr.helius-rpc.com

# Helius API key used for LaserStream auth
HELIUS_API_KEY=your-helius-api-key

# Target wallet to monitor
TARGET_WALLET=your-target-wallet

# Private key used for mirroring wallet
# Supported formats:
# - JSON array: [1,2,3,...]
# - comma-separated bytes: 1,2,3,...
# - base58 string
MIRROR_PRIVATE_KEY=your-private-key
